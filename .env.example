# Copie para .env e preencha. Nunca versione o .env.

# Postgres. Use a URL direta (sem -pooler) para migrations e a com pooler em runtime, se houver.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo do NextAuth (JWT). Gere com: npx auth secret
AUTH_SECRET=""

# Chave de API do Google Drive (biblioteca e curvas de crescimento).

# Somente para `npm run db:seed` em banco LOCAL descartÃ¡vel.
# O seed apaga tudo e recusa rodar sem SEED_CONFIRM=apagar-tudo e sem SEED_PASSWORD (mÃ­nimo de 12 caracteres).
# SEED_CONFIRM=""
# SEED_PASSWORD=""

# Operadores da plataforma (criam hospitais clientes em Admin > Plataforma): e-mails de ADMIN separados por virgula.
# Sem isso o recurso fica desligado.
PLATAFORMA_ADMIN_EMAILS=""
