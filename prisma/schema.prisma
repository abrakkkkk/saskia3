  tipo        String
  quantidade  Int      @default(1)
  embalagem   String
  integridade String   @default("Íntegra")
  createdAt   DateTime @default(now())

  @@index([loteId])
}

model TransportePaciente {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  paciente    String
  origem      String
  destino     String
  tipo        String
  solicitante String
  data        String
  status      String   @default("Pendente") // Pendente, Concluído
  createdAt   DateTime @default(now())

  @@index([hospitalId])
}

