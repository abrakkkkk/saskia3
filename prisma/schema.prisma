generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (Listas de valores fixos)
// ==========================================

enum CargoUsuario {
  ADMIN
  MEDICO
  ENFERMEIRO_ASSISTENCIAL
  TECNICO_ENFERMAGEM
  RECEPCIONISTA
  FARMACEUTICO
  OUTROS
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  EM_ESPERA
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
  FALTOU
}

enum StatusExame {
  SOLICITADO
  AGENDADO
  COLETADO
  EM_ANALISE
  CONCLUIDO
  CANCELADO
}

enum StatusCirurgia {
  AGENDADA
  EM_PREPARO
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TipoLeito {
  ADULTO
  PEDIATRICO
  NEONATAL
}

enum StatusOcupacao {
  LIVRE
  OCUPADO
  RESERVADO
  MANUTENCAO
  LIMPEZA
}

enum PrioridadeTicket {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusTicket {
  ENVIADO
  EM_ANALISE
  RESOLVIDO
  FECHADO
}

enum StatusChamada {
  ATIVA
  EM_ESPERA
  FINALIZADA
  CANCELADA
}

// ==========================================
// MODELS
// ==========================================

model Hospital {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String   @unique
  endereco  String?
  telefone  String?
  email     String?
  logo      String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios             Usuario[]
  pacientes            Paciente[]
  agendamentos         Agendamento[]
  receitas             Receita[]
  cirurgias            Cirurgia[]
  utiLeitos            UtiLeito[]
  salas                Sala[]
  tickets              Ticket[]
  chamadas             Chamada[]
  emergencias          Emergencia[]
  estoqueItems         EstoqueItem[]
  exames               Exame[]
  configDashboard      ConfigDashboard?
  obitos               Obito[]
  mensagensChat        MensagemChat[]
  casosSociais         CasoSocial[]
  ouvidoriaTickets     OuvidoriaTicket[]
  veiculosTransporte   VeiculoTransporte[]
  transportesPaciente  TransportePaciente[]
  ocorrenciasSeguranca OcorrenciaSeguranca[]
  operadorasPlano      OperadoraPlano[]
  estoqueSangue        EstoqueSangue[]
  movimentacoesEstoque MovimentacaoEstoque[]
  reservasSala         ReservaSala[]
  manutencaoOrdens     ManutencaoOS[]
  cssdLotes            CssdLote[]
  faturas              Fatura[]
  adminLogs            AdminLog[]
  lembretes            Lembrete[]
  pontoRegistros       PontoRegistro[]
  feedbacks            Feedback[]
  ccihRegistros        CcihRegistro[]
  categorias           Categoria[]
  procedimentos        Procedimento[]
  modelosProntuarios   ModeloProntuario[]
  visitantes           Visitante[]
}

model Usuario {
  id             String          @id @default(uuid())
  hospitalId     String
  hospital       Hospital        @relation(fields: [hospitalId], references: [id])
  nome           String
  email          String          @unique
  senha          String
  cargo          CargoUsuario    @default(ENFERMEIRO_ASSISTENCIAL)
  avatar         String?
  ativo          Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  pontoRegistros PontoRegistro[]
  feedbacks      Feedback[]

  @@index([hospitalId])
}

model Paciente {
  id              String    @id @default(uuid())
  hospitalId      String
  hospital        Hospital  @relation(fields: [hospitalId], references: [id])
  nome            String
  cpf             String?
  rg              String?
  nascimento      DateTime?
  sexo            String?
  telefone        String?
  email           String?
  endereco        String?
  convenio        String?
  numConvenio     String?
  mae             String?
  pai             String?
  profissao       String?
  estadoCivil     String?
  nacionalidade   String?
  naturalidade    String?
  religiao        String?
  etnia           String?
  tipoSanguineo   String?
  alergias        String?
  status          String    @default("Recepção")
  classificacao   String?
  leitoTipo       String?
  leitoNumero     Int?
  consultorio     String?
  queixaPrincipal String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  triagens     Triagem[]
  evolucoes    Evolucao[]
  prescricoes  Prescricao[]
  receitas     Receita[]
  agendamentos Agendamento[]
  exames       Exame[]
  cirurgias    Cirurgia[]
  chamadas     Chamada[]

  sinaisVitais         SinalVital[]
  escoresClinicos      EscoreClinico[]
  avaliacoesNutri      AvaliacaoNutricional[]
  visitantes           Visitante[]
  avaliacoesMedicas    AvaliacaoMedica[]
  anotacoesEnf         AnotacaoEnfermagem[]
  timelineEvents       TimelineEvent[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@unique([cpf, hospitalId]) // Proteção contra CPFs duplicados no mesmo hospital
  @@index([hospitalId])
  @@index([cpf])
}

model Triagem {
  id            String   @id @default(uuid())
  pacienteId    String
  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  classificacao String
  pressao       String? // Mantido como String para formatos como "120/80"
  temperatura   Float? // Convertido para número decimal (ex: 37.5)
  frequenciaC   Int? // Convertido para número inteiro (ex: 80 bpm)
  frequenciaR   Int? // Convertido para número inteiro (ex: 16 irpm)
  saturacao     Int? // Convertido para número inteiro (ex: 98%)
  glicemia      Int? // Convertido para número inteiro (ex: 95 mg/dL)
  peso          Float? // Convertido para número decimal (ex: 75.5 kg)
  altura        Float? // Convertido para número decimal (ex: 1.75 m)
  dor           Int? // Mantido Int (escala de 0 a 10)
  queixa        String?
  observacoes   String?
  profissional  String?
  createdAt     DateTime @default(now())

  @@index([pacienteId])
}

model Evolucao {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  tipo         String
  descricao    String
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
}

model Prescricao {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  medicamento  String
  dose         String?
  via          String?
  frequencia   String?
  observacoes  String?
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
}

model Receita {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  medicamentos Json
  observacoes  String?
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
  @@index([hospitalId])
}

model Agendamento {
  id            String            @id @default(uuid())
  pacienteId    String
  paciente      Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId    String
  hospital      Hospital          @relation(fields: [hospitalId], references: [id])
  dataHora      DateTime // Unificado: substitui data e hora soltas
  tipo          String?
  especialidade String?
  profissional  String?
  sala          String?
  status        StatusAgendamento @default(AGENDADO)
  observacoes   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([pacienteId])
  @@index([hospitalId])
  @@index([dataHora])
}

model Exame {
  id           String      @id @default(uuid())
  pacienteId   String
  paciente     Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     Hospital    @relation(fields: [hospitalId], references: [id])
  tipo         String
  nome         String
  resultado    String?
  status       StatusExame @default(SOLICITADO)
  profissional String?
  observacoes  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([pacienteId])
  @@index([hospitalId])
}

model Cirurgia {
  id           String         @id @default(uuid())
  pacienteId   String
  paciente     Paciente       @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  procedimento String
  sala         String?
  dataHora     DateTime? // Unificado: substitui data e hora soltas
  equipe       String?
  anestesia    String?
  status       StatusCirurgia @default(AGENDADA)
  observacoes  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([pacienteId])
  @@index([hospitalId])
}

model UtiLeito {
  id           String         @id @default(uuid())
  hospitalId   String
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  numero       Int
  tipo         TipoLeito      @default(ADULTO)
  status       StatusOcupacao @default(LIVRE)
  pacienteNome String?
  pacienteCpf  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([hospitalId])
}

model Sala {
  id         String         @id @default(uuid())
  hospitalId String
  hospital   Hospital       @relation(fields: [hospitalId], references: [id])
  nome       String
  tipo       String?
  setor      String?
  andar      String?
  status     StatusOcupacao @default(LIVRE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  reservas ReservaSala[]

  @@index([hospitalId])
}

model Ticket {
  id          String           @id @default(uuid())
  hospitalId  String
  hospital    Hospital         @relation(fields: [hospitalId], references: [id])
  numero      Int              @unique @default(autoincrement())
  solicitante String
  titulo      String
  descricao   String
  prioridade  PrioridadeTicket @default(MEDIA)
  status      StatusTicket     @default(ENVIADO)
  respostas   Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([hospitalId])
}

model Chamada {
  id           String        @id @default(uuid())
  hospitalId   String
  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  pacienteId   String?
  paciente     Paciente?     @relation(fields: [pacienteId], references: [id])
  pacienteNome String
  cpf          String?
  consultorio  String
  status       StatusChamada @default(ATIVA)
  createdAt    DateTime      @default(now())

  @@index([hospitalId])
}

model Emergencia {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  tipo         String
  profissional String
  createdAt    DateTime @default(now())

  @@index([hospitalId])
}

model EstoqueItem {
  id          String    @id @default(uuid())
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id])
  categoria   String
  nome        String
  codigo      String?
  quantidade  Int       @default(0)
  unidade     String?
  minimo      Int       @default(0)
  lote        String?
  validade    DateTime?
  fornecedor  String?
  localizacao String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  movimentacoes MovimentacaoEstoque[]

  @@index([hospitalId])
  @@index([categoria])
}

model ModeloProntuario {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  titulo     String
  descricao  String?
  campos     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([hospitalId])
}

model ConfigDashboard {
  id         String   @id @default(uuid())
  hospitalId String   @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  config     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// MÓDULOS DE GESTÃO (Fase 10)
// ==========================================

model Obito {
  id              String   @id @default(uuid())
  hospitalId      String
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  nome            String
  nascimento      String?
  cpf             String?
  sexo            String?
  data            String
  hora            String
  local           String?
  causa           String
  causaSec        String?
  medico          String
  prontuario      String?
  responsavel     String?
  telefone        String?
  observacoes     String?
  registradoPor   String?
  dataRegistro    String?
  certidaoEmitida Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([hospitalId])
}

model MensagemChat {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  remetente  String
  texto      String
  dataHora   DateTime @default(now())

  @@index([hospitalId])
}

model CasoSocial {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  pacienteNome String
  situacao     String
  detalhe      String
  status       String   @default("EM ACOMPANHAMENTO")
  createdAt    DateTime @default(now())

  @@index([hospitalId])
}

model OuvidoriaTicket {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  protocolo  String   @unique
  tipo       String
  setor      String
  paciente   String
  mensagem   String
  status     String   @default("ABERTO")
  prazo      String
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

model VeiculoTransporte {
  id            String   @id @default(uuid())
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id])
  tipo          String
  identificador String // Placa ou ID
  status        String   @default("DISPONÍVEL")
  local         String
  createdAt     DateTime @default(now())

  @@index([hospitalId])
}

model OcorrenciaSeguranca {
  id            String    @id @default(uuid())
  hospitalId    String
  hospital      Hospital  @relation(fields: [hospitalId], references: [id])
  tipo          String
  local         String
  relato        String
  vigilante     String
  dataHora      DateTime  @default(now())
  resolvido     Boolean   @default(false)
  resolvidoPor  String?
  dataResolucao DateTime?

  @@index([hospitalId])
}

model OperadoraPlano {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  nome       String
  codigoAns  String
  vigencia   String
  status     String   @default("ATIVO")
  teto       String
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

model EstoqueSangue {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  tipo       String
  quantidade Int
  status     String   @default("NORMAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([hospitalId])
}

model SinalVital {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  pressao      String?
  fc           String?
  fr           String?
  temp         String?
  satO2        String?
  glicemia     String?
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
}

model EscoreClinico {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  glasgow      Json?
  dor          Int?
  braden       Json?
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
}

model AvaliacaoNutricional {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  peso         String?
  altura       String?
  dieta        String?
  restricoes   String?
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
}

model AvaliacaoMedica {
  id            String   @id @default(uuid())
  pacienteId    String
  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  responsavel   String?
  crm           String?
  especialidade String?
  diagnostico   String?
  conduta       String?
  profissional  String?
  createdAt     DateTime @default(now())

  @@index([pacienteId])
}

model AnotacaoEnfermagem {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  responsavel  String?
  coren        String?
  evolucao     String?
  prescricao   String?
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
}

model TimelineEvent {
  id         String   @id @default(uuid())
  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  tipo       String
  descricao  String
  user       String?
  createdAt  DateTime @default(now())

  @@index([pacienteId])
}

model MovimentacaoEstoque {
  id          String      @id @default(uuid())
  hospitalId  String
  hospital    Hospital    @relation(fields: [hospitalId], references: [id])
  tipo        String // "ENTRADA" ou "SAIDA"
  itemId      String
  item        EstoqueItem @relation(fields: [itemId], references: [id])
  quantidade  Int
  pacienteId  String?
  paciente    Paciente?   @relation(fields: [pacienteId], references: [id])
  setor       String?
  fornecedor  String?
  responsavel String
  observacao  String?
  createdAt   DateTime    @default(now())

  @@index([hospitalId])
  @@index([itemId])
}

model ReservaSala {
  id           String   @id @default(uuid())
  salaId       String
  sala         Sala     @relation(fields: [salaId], references: [id])
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  profissional String
  paciente     String?
  data         String
  horaInicio   String
  horaFim      String
  status       String   @default("ATIVA")
  createdAt    DateTime @default(now())

  @@index([salaId])
  @@index([hospitalId])
}

// ==========================================
// MÓDULOS ADMINISTRATIVOS (Fase 5)
// ==========================================

model ManutencaoOS {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  equipamento String
  setor       String
  tipo        String // Corretiva, Preventiva, Preditiva, Calibração, Emergencial
  prioridade  String   @default("Normal")
  solicitante String
  data        String
  descricao   String?
  status      String   @default("Aberta") // Aberta, Em Andamento, Concluída
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hospitalId])
}

model CssdLote {
  id                 String   @id @default(uuid())
  hospitalId         String
  hospital           Hospital @relation(fields: [hospitalId], references: [id])
  numero             String
  setor              String
  operador           String
  data               String
  equipamento        String
  ciclo              String
  indicadorQuimico   String
  indicadorBiologico String
  bowieDick          String
  obs                String?
  status             String   @default("Recepção") // Recepção, Limpeza, Preparo, Esterilização, Pronto, Rejeitado
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  itens CssdItem[]

  @@index([hospitalId])
}

model CssdItem {
  id          String   @id @default(uuid())
  loteId      String
  lote        CssdLote @relation(fields: [loteId], references: [id], onDelete: Cascade)
  nome        String
  tipo        String
  quantidade  Int      @default(1)
  embalagem   String
  integridade String   @default("Íntegra")
  createdAt   DateTime @default(now())

  @@index([loteId])
}

model TransportePaciente {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  paciente    String
  origem      String
  destino     String
  tipo        String
  solicitante String
  data        String
  status      String   @default("Pendente") // Pendente, Concluído
  createdAt   DateTime @default(now())

  @@index([hospitalId])
}

// ==========================================
// MODELS ADICIONADOS PARA SUBSTITUIR LOCALSTORAGE
// ==========================================

model Fatura {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  valor      Float
  vencimento DateTime
  status     String   @default("Pendente")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([hospitalId])
}

model AdminLog {
  id         String    @id @default(uuid())
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  usuario    String
  acao       String
  detalhes   String?
  createdAt  DateTime  @default(now())

  @@index([hospitalId])
}

model Lembrete {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  titulo      String
  tipo        String   @default("consulta")
  descricao   String?
  relacionado String?
  dataHora    DateTime
  concluido   Boolean  @default(false)
  criadoPor   String?
  status      String   @default("Pendente")
  createdAt   DateTime @default(now())

  @@index([hospitalId])
}

model PontoRegistro {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  tipo        String // ENTRADA, SAIDA, PAUSA_INICIO, PAUSA_FIM
  dataHora    DateTime @default(now())
  localizacao String?
  createdAt   DateTime @default(now())

  @@index([hospitalId])
  @@index([usuarioId])
}

model Feedback {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  tipo       String // SUGESTAO, ELOGIO, RECLAMACAO
  mensagem   String
  status     String   @default("NOVO")
  createdAt  DateTime @default(now())

  @@index([hospitalId])
  @@index([usuarioId])
}

model CcihRegistro {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  tipo       String // IRAS, CULTURA, HM, ATM
  subtipo    String?
  descricao  String?
  dados      Json?
  data       DateTime
  status     String   @default("ATIVO")
  criadoPor  String?
  createdAt  DateTime @default(now())

  @@index([hospitalId])
  @@index([tipo])
}

model Categoria {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  nome       String
  tipo       String // PRODUTO, SERVICO, MEDICAMENTO, etc.
  descricao  String?
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

model Procedimento {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  codigo     String?
  nome       String
  descricao  String?
  valorBase  Float?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}


model Visitante {
  id         String    @id @default(uuid())
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id])
  nome       String
  documento  String?   // RG ou CPF
  destino    String?   // Ex: Leito 104, UTI, Diretoria
  pacienteId String?
  paciente   Paciente? @relation(fields: [pacienteId], references: [id])
  entrada    DateTime  @default(now())
  saida      DateTime?
  status     String    @default("DENTRO") // "DENTRO" ou "SAIU"

  @@index([hospitalId])
  @@index([pacienteId])
}
