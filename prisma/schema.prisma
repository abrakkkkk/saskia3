// Trilha append-only de leitura e escrita (LGPD art. 37). Sem FK: precisa sobreviver a qualquer registro.
model Auditoria {
  id          String   @id @default(uuid())
  hospitalId  String
  usuarioId   String
  usuarioNome String
  cargo       String
  acao        String
  entidade    String
  entidadeId  String?
  detalhes    Json?
  createdAt   DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([hospitalId, entidade, entidadeId])
  @@index([usuarioId])
}

