// ==========================================
// FATURAMENTO HOSPITALAR (item 7): TISS (convênios) e produção SUS (BPA e AIH).
// Não confundir com Fatura, que é a cobrança do SaaS.
// ==========================================

// Dados da unidade exigidos pelos arquivos do SUS (uma linha por hospital).
model ConfigFaturamento {
  id               String   @id @default(uuid())
  hospitalId       String   @unique
  hospital         Hospital @relation(fields: [hospitalId], references: [id])
  /// CNES com 7 dígitos (o último é o verificador).
  cnes             String?
  /// Município do estabelecimento, código IBGE de 6 dígitos (sem verificador).
  municipioIbge    String?
  uf               String?
  /// Órgão de destino do BPA (ex.: Secretaria Municipal de Saúde) e tipo: M (municipal) ou E (estadual).
  orgaoDestinoNome String?
  orgaoDestinoTipo String   @default("M")
  orgaoOrigemNome  String?
  orgaoOrigemSigla String?
  /// Órgão emissor da AIH (10 posições, Portaria SAS 567/2005).
  orgaoEmissorAih  String?
  updatedAt        DateTime @updatedAt
}

// Catálogo global de procedimentos e itens (sem dado de paciente): TUSS da ANS e SIGTAP do SUS.
// tabela: "22" (procedimentos), "18" (diárias e taxas), "19" (materiais), "20" (medicamentos), "38" (glosas) ou "SIGTAP".
model ProcedimentoTabela {
  id              String   @id @default(uuid())
  tabela          String
  codigo          String
  descricao       String
  /// Versão TUSS (AAAAMM) ou competência SIGTAP (AAAAMM).
  versao          String
  valorSh         Decimal? @db.Decimal(12, 2)
  valorSa         Decimal? @db.Decimal(12, 2)
  valorSp         Decimal? @db.Decimal(12, 2)
  complexidade    String?
  sexo            String?
  idadeMin        Int?
  idadeMax        Int?
  diasPermanencia Int?
  /// Instrumentos de registro SIGTAP: 01 BPA-C, 02 BPA-I, 03 AIH principal, 04 AIH especial, 05 AIH secundário...
  instrumentos    String[] @default([])
  ativo           Boolean  @default(true)
  busca           String
  updatedAt       DateTime @updatedAt

  @@unique([tabela, codigo])
  @@index([tabela, ativo])
}

// Preço combinado com cada convênio (tabela própria do contrato).
model PrecoConvenio {
  id          String         @id @default(uuid())
  hospitalId  String
  hospital    Hospital       @relation(fields: [hospitalId], references: [id])
  operadoraId String
  operadora   OperadoraPlano @relation(fields: [operadoraId], references: [id], onDelete: Cascade)
  tabela      String
  codigo      String
  valor       Decimal        @db.Decimal(12, 2)
  updatedAt   DateTime       @updatedAt

  @@unique([operadoraId, tabela, codigo])
  @@index([hospitalId])
}

// Conta de um atendimento: vira guia TISS (convênio) ou linha de BPA/AIH (SUS).
// status: ABERTA -> FECHADA -> EM_LOTE -> ENVIADA -> PAGA | GLOSADA; CANCELADA antes de entrar em lote.
model ContaFaturamento {
  id                    String           @id @default(uuid())
  hospitalId            String
  hospital              Hospital         @relation(fields: [hospitalId], references: [id])
  /// Sequencial por hospital; vira o número da guia do prestador.
  numero                Int
  pacienteId            String
  paciente              Paciente         @relation(fields: [pacienteId], references: [id])
  internacaoId          String?
  internacao            Internacao?      @relation(fields: [internacaoId], references: [id], onDelete: SetNull)
  /// CONVENIO ou SUS.
  fonte                 String
  /// CONSULTA, SP_SADT, RESUMO_INTERNACAO (TISS); BPA_C, BPA_I, AIH (SUS).
  tipoGuia              String
  status                String           @default("ABERTA")
  /// Competência AAAAMM (produção SUS e controle do mês).
  competencia           String
  dataAtendimento       DateTime
  dataFim               DateTime?
  operadoraId           String?
  operadora             OperadoraPlano?  @relation(fields: [operadoraId], references: [id], onDelete: SetNull)
  numeroCarteira        String?
  senhaAutorizacao      String?
  numeroGuiaOperadora   String?
  dataAutorizacao       DateTime?
  cid                   String?
  /// TISS tabela 23: 1 eletivo, 2 urgência/emergência.
  caraterAtendimento    String           @default("1")
  /// TISS tabela 36: 0 trabalho, 1 trânsito, 2 outros, 9 não acidente.
  indicacaoAcidente     String           @default("9")
  tipoAtendimento       String?
  tipoConsulta          String?
  regimeAtendimento     String           @default("01")
  /// TISS tabela 39 (mesmos códigos do motivo de saída do SIH).
  motivoEncerramento    String?
  tipoInternacao        String?
  regimeInternacao      String?
  profissionalId        String?
  profissionalNome      String?
  conselho              String?
  numeroConselho        String?
  ufConselho            String?
  cbo                   String?
  cnsProfissional       String?
  // Dados do paciente exigidos pelo SUS (fotografia no momento da conta).
  cnsPaciente           String?
  racaCor               String?
  municipioIbgePaciente String?
  cepPaciente           String?
  numeroAih             String?
  procedimentoPrincipal String?
  especialidadeAih      String?
  observacao            String?
  valorTotal            Decimal          @default(0) @db.Decimal(12, 2)
  valorGlosado          Decimal          @default(0) @db.Decimal(12, 2)
  valorPago             Decimal?         @db.Decimal(12, 2)
  loteId                String?
  lote                  LoteFaturamento? @relation(fields: [loteId], references: [id], onDelete: SetNull)
  criadoPorId           String?
  criadoPorNome         String?
  fechadoEm             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  itens ItemConta[]

  @@unique([hospitalId, numero])
  @@index([hospitalId, status])
  @@index([hospitalId, competencia, fonte])
  @@index([pacienteId])
  @@index([internacaoId])
  @@index([loteId])
}

// Item lançado na conta (procedimento, diária, taxa, material, medicamento).
model ItemConta {
  id            String           @id @default(uuid())
  hospitalId    String
  hospital      Hospital         @relation(fields: [hospitalId], references: [id])
  contaId       String
  conta         ContaFaturamento @relation(fields: [contaId], references: [id], onDelete: Cascade)
  /// "22", "18", "19", "20", "00" (tabela própria) ou "SIGTAP".
  tabela        String
  codigo        String
  descricao     String
  quantidade    Decimal          @db.Decimal(10, 4)
  valorUnitario Decimal          @db.Decimal(12, 2)
  valorTotal    Decimal          @db.Decimal(12, 2)
  dataExecucao  DateTime
  /// Outras despesas TISS (tabela 25): 01 gases, 02 medicamentos, 03 materiais, 05 diárias, 07 taxas, 08 OPME. Nulo = procedimento.
  codigoDespesa String?
  /// TISS tabela 60 (036 = unidade).
  unidadeMedida String?
  cbo           String?
  valorGlosado  Decimal          @default(0) @db.Decimal(12, 2)
  /// Código da glosa (TISS tabela 38).
  motivoGlosa   String?
  createdAt     DateTime         @default(now())

  @@index([contaId])
  @@index([hospitalId])
}

// Arquivo gerado: lote XML TISS por convênio ou arquivo BPA/AIH por competência.
// status: GERADO -> ENVIADO -> PROCESSADO; CANCELADO devolve as contas para FECHADA.
model LoteFaturamento {
  id               String          @id @default(uuid())
  hospitalId       String
  hospital         Hospital        @relation(fields: [hospitalId], references: [id])
  /// TISS, BPA ou AIH.
  tipo             String
  numero           Int
  operadoraId      String?
  operadora        OperadoraPlano? @relation(fields: [operadoraId], references: [id], onDelete: SetNull)
  competencia      String?
  tipoGuia         String?
  status           String          @default("GERADO")
  arquivoNome      String
  arquivoConteudo  String
  hash             String?
  quantidadeContas Int
  valorTotal       Decimal         @db.Decimal(12, 2)
  protocolo        String?
  enviadoEm        DateTime?
  geradoPorId      String?
  geradoPorNome    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  contas ContaFaturamento[]

  @@unique([hospitalId, tipo, numero])
  @@index([hospitalId, createdAt])
}

// ==========================================
// INTEROPERABILIDADE (item 8): CNES e RNDS.
// ==========================================

// Equipe do estabelecimento na base oficial do CNES (dado público do DATASUS), importada por scripts/importar-cnes.cjs.
// Serve para conferir CNS e CBO dos usuários do Saskia. Uma linha por profissional e CBO na competência importada.
model CnesProfissional {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  cnes         String
  /// Competência da base (AAAAMM).
  competencia  String
  cns          String
  nome         String
  cbo          String
  cargaHoraria Int?
  createdAt    DateTime @default(now())

  @@unique([hospitalId, cns, cbo])
  @@index([hospitalId])
}

enum StatusEnvioRnds {
  PENDENTE
  ENVIADO
  ERRO
  /// Modo simulação: documento gerado e validado contra os perfis oficiais, sem envio.
  SIMULADO
}

// Configuração da RNDS por hospital. Segredos (certificado ICP-Brasil e senha) NUNCA ficam no banco:
// vêm das variáveis de ambiente RNDS_CERT_PFX_<CNES> (PFX em base64) e RNDS_CERT_SENHA_<CNES>.
model IntegracaoRnds {
  id                       String   @id @default(uuid())
  hospitalId               String   @unique
  hospital                 Hospital @relation(fields: [hospitalId], references: [id])
  /// SIMULACAO (valida sem enviar), HOMOLOGACAO (ehr-services.hmg) ou PRODUCAO ({uf}-ehr-services).
  ambiente                 String   @default("SIMULACAO")
  /// Identificador do solicitante dado pela RNDS no credenciamento (NamingSystem BRRNDS-{id}).
  identificadorSolicitante String?
  /// CNS do profissional requisitante (cabeçalho Authorization), com vínculo CBO autorizado no estabelecimento.
  cnsRequisitante          String?
  /// Enfileirar automaticamente cada dose registrada.
  envioAutomatico          Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

// Dose de imunobiológico aplicada (Registro de Imunobiológico Administrado em Rotina da RNDS).
// Códigos das tabelas oficiais da RNDS: BRImunobiologico, BRFabricantePNI, BRDose, BREstrategiaVacinacao,
// BRViaAdministracao, BRLocalAplicacao, BRGrupoAtendimento, BRCondicaoMaternal.
model VacinaAplicada {
  id               String    @id @default(uuid())
  hospitalId       String
  hospital         Hospital  @relation(fields: [hospitalId], references: [id])
  pacienteId       String
  paciente         Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  imunobiologico   String
  fabricante       String
  lote             String
  validade         DateTime?
  dose             String
  estrategia       String    @default("1")
  via              String
  localAplicacao   String
  grupoAtendimento String    @default("00")
  condicaoMaternal String    @default("1")
  /// 01 transcrição de caderneta, 02 vacina no exterior (com país). Vazio: aplicada aqui.
  registroOrigem   String?
  pais             String?
  aplicadaEm       DateTime
  profissionalId   String?
  profissionalNome String
  observacoes      String?
  createdAt        DateTime  @default(now())

  @@index([hospitalId, pacienteId])
  @@index([hospitalId, aplicadaEm])
}

// Fila de envio à RNDS. Um registro por origem (dose ou exame); reenvio e retificação reaproveitam o mesmo
// identificadorLocal, como pede o guia. Erros guardados sem número de CNS/CPF (LGPD).
model EnvioRnds {
  id                 String          @id @default(uuid())
  hospitalId         String
  hospital           Hospital        @relation(fields: [hospitalId], references: [id])
  /// RIA_R (vacinação de rotina) ou REL (resultado de exame laboratorial).
  tipo               String
  /// Id da VacinaAplicada ou do Exame.
  origemId           String
  identificadorLocal String          @unique
  status             StatusEnvioRnds @default(PENDENTE)
  ambiente           String?
  tentativas         Int             @default(0)
  ultimoErro         String?
  /// Caminhos e mensagens da validação (sem dados do paciente).
  problemas          Json?
  /// Códigos do REL informados ao enfileirar o exame (exame, resultado, amostra, método...). Sem identificação.
  dadosExame         Json?
  /// Id atribuído pela RNDS (header location); usado para retificar.
  idRnds             String?
  criadoPorId        String?
  criadoPorNome      String?
  enviadoEm          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([hospitalId, tipo, origemId])
  @@index([hospitalId, status])
}

// ==========================================
// Item 10: checklist cirúrgico e evolução de UTI (modelos oficiais MS/Anvisa)
// ==========================================

/// Etapa da Lista de Verificação de Segurança Cirúrgica (Protocolo para Cirurgia Segura, MS/Anvisa/Fiocruz 2013, base OMS).
enum EtapaChecklistCirurgico {
  ANTES_INDUCAO
  ANTES_INCISAO
  ANTES_SAIDA
}

/// Uma linha por etapa respondida da cirurgia. A ordem das etapas é exigida pela API.
model ChecklistCirurgicoEtapa {
  id                 String                  @id @default(uuid())
  hospitalId         String
  hospital           Hospital                @relation(fields: [hospitalId], references: [id])
  cirurgiaId         String
  cirurgia           Cirurgia                @relation(fields: [cirurgiaId], references: [id], onDelete: Cascade)
  etapa              EtapaChecklistCirurgico
  /// Respostas por id do item (ver src/lib/checklist-cirurgico.ts).
  respostas          Json
  observacoes        String?
  /// Versão do modelo usado (ex.: MS-ANVISA-2013).
  modelo             String
  respondidoPorId    String
  respondidoPorNome  String
  respondidoPorCargo String
  respondidoEm       DateTime                @default(now())

  @@unique([cirurgiaId, etapa])
  @@index([hospitalId, respondidoEm])
}

/// Evolução diária na UTI (RDC Anvisa 7/2010: registro ao menos uma vez ao dia). Ligada à internação (item 9).
model EvolucaoUti {
  id            String     @id @default(uuid())
  hospitalId    String
  hospital      Hospital   @relation(fields: [hospitalId], references: [id])
  internacaoId  String
  internacao    Internacao @relation(fields: [internacaoId], references: [id], onDelete: Cascade)
  pacienteId    String
  utiLeitoId    String?
  registradoEm  DateTime   @default(now())
  autorId       String
  autorNome     String
  autorCargo    String
  pas           Int?
  pad           Int?
  fc            Int?
  fr            Int?
  temperatura   Float?
  spo2          Int?
  glicemia      Int?
  /// [{ tipo, local, inseridoEm }]
  dispositivos  Json?
  ventilacao    String?
  fio2          Int?
  peep          Int?
  ventilacaoObs String?
  entradasMl    Int?
  saidasMl      Int?
  rass          Int?
  glasgowOcular Int?
  glasgowVerbal Int?
  glasgowMotora Int?
  glasgowTotal  Int?
  /// { percepcao, umidade, atividade, mobilidade, nutricao, friccao }
  bradenItens   Json?
  bradenTotal   Int?
  dor           Int?
  dorEscala     String?
  evolucao      String
  modelo        String
  createdAt     DateTime   @default(now())

  @@index([hospitalId, internacaoId, registradoEm])
  @@index([hospitalId, registradoEm])
}

/// Validação do modelo clínico pelo hospital (decisão do dono, 21/11/2026). Sem linha: usa o modelo padrão MS/Anvisa.
model ValidacaoModeloClinico {
  id              String   @id @default(uuid())
  hospitalId      String
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  /// CHECKLIST_CIRURGICO ou EVOLUCAO_UTI
  modelo          String
  validadoEm      DateTime @default(now())
  validadoPorId   String
  validadoPorNome String
  observacao      String?

  @@unique([hospitalId, modelo])
}
