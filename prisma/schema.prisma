generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (Listas de valores fixos)
// ==========================================

enum CargoUsuario {
  ADMIN
  MEDICO
  ENFERMEIRO_ASSISTENCIAL
  TECNICO_ENFERMAGEM
  RECEPCIONISTA
  FARMACEUTICO
  OUTROS
}


enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  EM_ESPERA
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
  FALTOU
}

enum StatusExame {
  SOLICITADO
  AGENDADO
  COLETADO
  EM_ANALISE
  CONCLUIDO
  CANCELADO
}

enum StatusCirurgia {
  AGENDADA
  EM_PREPARO
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TipoLeito {
  ADULTO
  PEDIATRICO
  NEONATAL
}

enum StatusOcupacao {
  LIVRE
  OCUPADO
  RESERVADO
  MANUTENCAO
  LIMPEZA
}

enum PrioridadeTicket {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusTicket {
  ENVIADO
  EM_ANALISE
  RESOLVIDO
  FECHADO
}

enum StatusChamada {
  ATIVA
  EM_ESPERA
  FINALIZADA
  CANCELADA
}

// ==========================================
// MODELS
// ==========================================

model Hospital {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String   @unique
  endereco  String?
  telefone  String?
  email     String?
  logo      String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios        Usuario[]
  pacientes       Paciente[]
  agendamentos    Agendamento[]
  receitas        Receita[]
  cirurgias       Cirurgia[]
  utiLeitos       UtiLeito[]
  salas           Sala[]
  tickets         Ticket[]
  chamadas        Chamada[]
  emergencias     Emergencia[]
  estoqueItems    EstoqueItem[]
  exames          Exame[]
  configDashboard ConfigDashboard?
  obitos          Obito[]
  mensagensChat   MensagemChat[]
  casosSociais    CasoSocial[]
  ouvidoriaTickets OuvidoriaTicket[]
  veiculosTransporte VeiculoTransporte[]
  ocorrenciasSeguranca OcorrenciaSeguranca[]
  operadorasPlano OperadoraPlano[]
  estoqueSangue   EstoqueSangue[]
}

model Usuario {
  id         String       @id @default(uuid())
  hospitalId String
  hospital   Hospital     @relation(fields: [hospitalId], references: [id])
  nome       String
  email      String       @unique
  senha      String
  cargo      CargoUsuario @default(ENFERMEIRO_ASSISTENCIAL)
  avatar     String?
  ativo      Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([hospitalId])
}

model Paciente {
  id              String         @id @default(uuid())
  hospitalId      String
  hospital        Hospital       @relation(fields: [hospitalId], references: [id])
  nome            String
  cpf             String?
  rg              String?
  nascimento      DateTime?
  sexo            String?
  telefone        String?
  email           String?
  endereco        String?
  convenio        String?
  numConvenio     String?
  mae             String?
  pai             String?
  profissao       String?
  estadoCivil     String?
  nacionalidade   String?
  naturalidade    String?
  religiao        String?
  etnia           String?
  tipoSanguineo   String?
  alergias        String?
  status          String         @default("Recepção")
  classificacao   String?
  leitoTipo       String?
  leitoNumero     Int?
  consultorio     String?
  queixaPrincipal String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  triagens     Triagem[]
  evolucoes    Evolucao[]
  prescricoes  Prescricao[]
  receitas     Receita[]
  agendamentos Agendamento[]
  exames       Exame[]
  cirurgias    Cirurgia[]
  chamadas     Chamada[]

  @@unique([cpf, hospitalId]) // Proteção contra CPFs duplicados no mesmo hospital
  @@index([hospitalId])
  @@index([cpf])
}

model Triagem {
  id            String   @id @default(uuid())
  pacienteId    String
  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  classificacao String
  pressao       String?  // Mantido como String para formatos como "120/80"
  temperatura   Float?   // Convertido para número decimal (ex: 37.5)
  frequenciaC   Int?     // Convertido para número inteiro (ex: 80 bpm)
  frequenciaR   Int?     // Convertido para número inteiro (ex: 16 irpm)
  saturacao     Int?     // Convertido para número inteiro (ex: 98%)
  glicemia      Int?     // Convertido para número inteiro (ex: 95 mg/dL)
  peso          Float?   // Convertido para número decimal (ex: 75.5 kg)
  altura        Float?   // Convertido para número decimal (ex: 1.75 m)
  dor           Int?     // Mantido Int (escala de 0 a 10)
  queixa        String?
  observacoes   String?
  profissional  String?
  createdAt     DateTime @default(now())

  @@index([pacienteId])
}

model Evolucao {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  tipo         String
  descricao    String
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
}

model Prescricao {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  medicamento  String
  dose         String?
  via          String?
  frequencia   String?
  observacoes  String?
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
}

model Receita {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  medicamentos Json
  observacoes  String?
  profissional String?
  createdAt    DateTime @default(now())

  @@index([pacienteId])
  @@index([hospitalId])
}

model Agendamento {
  id            String            @id @default(uuid())
  pacienteId    String
  paciente      Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId    String
  hospital      Hospital          @relation(fields: [hospitalId], references: [id])
  dataHora      DateTime          // Unificado: substitui data e hora soltas
  tipo          String?
  especialidade String?
  profissional  String?
  sala          String?
  status        StatusAgendamento @default(AGENDADO)
  observacoes   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([pacienteId])
  @@index([hospitalId])
  @@index([dataHora])
}

model Exame {
  id           String      @id @default(uuid())
  pacienteId   String
  paciente     Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     Hospital    @relation(fields: [hospitalId], references: [id])
  tipo         String
  nome         String
  resultado    String?
  status       StatusExame @default(SOLICITADO)
  profissional String?
  observacoes  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([pacienteId])
  @@index([hospitalId])
}

model Cirurgia {
  id           String         @id @default(uuid())
  pacienteId   String
  paciente     Paciente       @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  procedimento String
  sala         String?
  dataHora     DateTime?      // Unificado: substitui data e hora soltas
  equipe       String?
  anestesia    String?
  status       StatusCirurgia @default(AGENDADA)
  observacoes  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([pacienteId])
  @@index([hospitalId])
}

model UtiLeito {
  id           String         @id @default(uuid())
  hospitalId   String
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  numero       Int
  tipo         TipoLeito      @default(ADULTO)
  status       StatusOcupacao @default(LIVRE)
  pacienteNome String?
  pacienteCpf  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([hospitalId])
}

model Sala {
  id         String         @id @default(uuid())
  hospitalId String
  hospital   Hospital       @relation(fields: [hospitalId], references: [id])
  nome       String
  tipo       String?
  setor      String?
  andar      String?
  status     StatusOcupacao @default(LIVRE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([hospitalId])
}

model Ticket {
  id          String           @id @default(uuid())
  hospitalId  String
  hospital    Hospital         @relation(fields: [hospitalId], references: [id])
  numero      Int              @unique @default(autoincrement())
  solicitante String
  titulo      String
  descricao   String
  prioridade  PrioridadeTicket @default(MEDIA)
  status      StatusTicket     @default(ENVIADO)
  respostas   Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([hospitalId])
}

model Chamada {
  id           String        @id @default(uuid())
  hospitalId   String
  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  pacienteId   String?
  paciente     Paciente?     @relation(fields: [pacienteId], references: [id])
  pacienteNome String
  cpf          String?
  consultorio  String
  status       StatusChamada @default(ATIVA)
  createdAt    DateTime      @default(now())

  @@index([hospitalId])
}

model Emergencia {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  tipo         String
  profissional String
  createdAt    DateTime @default(now())

  @@index([hospitalId])
}

model EstoqueItem {
  id          String    @id @default(uuid())
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id])
  categoria   String
  nome        String
  codigo      String?
  quantidade  Int       @default(0)
  unidade     String?
  minimo      Int       @default(0)
  lote        String?
  validade    DateTime?
  fornecedor  String?
  localizacao String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([hospitalId])
  @@index([categoria])
}

model ConfigDashboard {
  id         String   @id @default(uuid())
  hospitalId String   @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  config     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// MÓDULOS DE GESTÃO (Fase 10)
// ==========================================

model Obito {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  pacienteNome String
  dataHora     DateTime
  medicoCrm    String
  causaBasi    String
  createdAt    DateTime @default(now())
  
  @@index([hospitalId])
}

model MensagemChat {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  remetente  String
  texto      String
  dataHora   DateTime @default(now())

  @@index([hospitalId])
}

model CasoSocial {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  pacienteNome String
  situacao     String
  detalhe      String
  status       String   @default("EM ACOMPANHAMENTO")
  createdAt    DateTime @default(now())

  @@index([hospitalId])
}

model OuvidoriaTicket {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  protocolo    String   @unique
  tipo         String
  setor        String
  paciente     String
  mensagem     String
  status       String   @default("ABERTO")
  prazo        String
  createdAt    DateTime @default(now())

  @@index([hospitalId])
}

model VeiculoTransporte {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  tipo       String
  identificador String // Placa ou ID
  status     String   @default("DISPONÍVEL")
  local      String
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

model OcorrenciaSeguranca {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  tipo       String
  local      String
  relato     String
  vigilante  String
  dataHora   DateTime @default(now())

  @@index([hospitalId])
}

model OperadoraPlano {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  nome       String
  codigoAns  String
  vigencia   String
  status     String   @default("ATIVO")
  teto       String
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

model EstoqueSangue {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  tipo       String
  quantidade Int
  status     String   @default("NORMAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([hospitalId])
}