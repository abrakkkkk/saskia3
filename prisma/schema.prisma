model ManutencaoOS {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  equipamento String
  setor       String
  tipo        String // Corretiva, Preventiva, Preditiva, Calibração, Emergencial
  prioridade  String   @default("Normal")
  solicitante String
  data        String
  descricao   String?
  status      String   @default("Aberta") // Aberta, Em Andamento, Concluída
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hospitalId])
}

model CssdLote {
  id                 String   @id @default(uuid())
  hospitalId         String
  hospital           Hospital @relation(fields: [hospitalId], references: [id])
  numero             String
  setor              String
  operador           String
  data               String
  equipamento        String
  ciclo              String
  indicadorQuimico   String
  indicadorBiologico String
  bowieDick          String
  obs                String?
  status             String   @default("Recepção") // Recepção, Limpeza, Preparo, Esterilização, Pronto, Rejeitado
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  itens CssdItem[]

  @@index([hospitalId])
}

model CssdItem {
  id          String   @id @default(uuid())
  loteId      String
  lote        CssdLote @relation(fields: [loteId], references: [id], onDelete: Cascade)
