generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (Listas de valores fixos)
// ==========================================

enum CargoUsuario {
  ADMIN
  MEDICO
  ENFERMEIRO_ASSISTENCIAL
  TECNICO_ENFERMAGEM
  RECEPCIONISTA
  FARMACEUTICO
  NUTRICIONISTA
  ASSISTENTE_SOCIAL
  OUTROS
  FISIOTERAPEUTA
  ODONTOLOGO
  FATURISTA
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  EM_ESPERA
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
  FALTOU
}

enum StatusExame {
  SOLICITADO
  AGENDADO
  COLETADO
  EM_ANALISE
  CONCLUIDO
  ALTERADO_CRITICO
  CANCELADO
}

enum StatusCirurgia {
  AGENDADA
  EM_PREPARO
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TipoLeito {
  ADULTO
  PEDIATRICO
  NEONATAL
}

enum StatusOcupacao {
  LIVRE
  OCUPADO
  RESERVADO
  MANUTENCAO
  LIMPEZA
}

enum TipoSaidaInternacao {
  ALTA_MEDICA
  TRANSFERENCIA
  EVASAO
  OBITO
}

enum PrioridadeTicket {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusTicket {
  ENVIADO
  EM_ANALISE
  RESOLVIDO
  FECHADO
}

enum StatusChamada {
  ATIVA
  EM_ESPERA
  FINALIZADA
  CANCELADA
}

// ==========================================
// MODELS
// ==========================================

model Hospital {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String   @unique
  /// Código curto da unidade digitado no login (substitui a lista pública de hospitais).
  codigo    String?  @unique
  endereco  String?
  telefone  String?
  email     String?
  logo      String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios             Usuario[]
  pacientes            Paciente[]
  agendamentos         Agendamento[]
  receitas             Receita[]
  cirurgias            Cirurgia[]
  utiLeitos            UtiLeito[]
  salas                Sala[]
  tickets              Ticket[]
  chamadas             Chamada[]
  emergencias          Emergencia[]
  estoqueItems         EstoqueItem[]
  exames               Exame[]
  configDashboard      ConfigDashboard?
  obitos               Obito[]
  mensagensChat        MensagemChat[]
  canaisChat           CanalChat[]
  casosSociais         CasoSocial[]
  ouvidoriaTickets     OuvidoriaTicket[]
  veiculosTransporte   VeiculoTransporte[]
  transportesPaciente  TransportePaciente[]
  ocorrenciasSeguranca OcorrenciaSeguranca[]
  operadorasPlano      OperadoraPlano[]
  estoqueSangue        EstoqueSangue[]
  movimentacoesEstoque MovimentacaoEstoque[]
  reservasSala         ReservaSala[]
  manutencaoOrdens     ManutencaoOS[]
  cssdLotes            CssdLote[]
  faturas              Fatura[]
  adminLogs            AdminLog[]
  lembretes            Lembrete[]
  pontoRegistros       PontoRegistro[]
  feedbacks            Feedback[]
  ccihRegistros        CcihRegistro[]
  categorias           Categoria[]
  procedimentos        Procedimento[]
  modelosProntuarios   ModeloProntuario[]
  visitantes           Visitante[]
  internacoes          Internacao[]
  movimentacoesLeito   MovimentacaoLeito[]
  configFaturamento    ConfigFaturamento?
  precosConvenio       PrecoConvenio[]
  contasFaturamento    ContaFaturamento[]
  itensConta           ItemConta[]
  lotesFaturamento     LoteFaturamento[]
  cnesProfissionais    CnesProfissional[]
  vacinasAplicadas     VacinaAplicada[]
  enviosRnds           EnvioRnds[]
  checklistsCirurgicos ChecklistCirurgicoEtapa[]
  evolucoesUti         EvolucaoUti[]
  validacoesModelo     ValidacaoModeloClinico[]
  integracaoRnds       IntegracaoRnds?
}

model Usuario {
  id                            String                  @id @default(uuid())
  hospitalId                    String
  hospital                      Hospital                @relation(fields: [hospitalId], references: [id])
  nome                          String
  email                         String                  @unique
  senha                         String
  cargo                         CargoUsuario            @default(ENFERMEIRO_ASSISTENCIAL)
  /// Registro no conselho profissional (CRM, COREN...). Sai impresso na receita e é exigido para prescrever.
  conselho                      String?
  registroNumero                String?
  registroUf                    String?
  especialidade                 String?
  /// Registro de Qualificação de Especialista (opcional).
  rqe                           String?
  /// Identificação SUS do profissional (item 8): CNS (15 dígitos, validado), CPF e CBO de lotação no CNES.
  cns                           String?
  cpf                           String?
  cbo                           String?
  /// Tipos de prescrição que o gestor autorizou este usuário a emitir (FARMACOLOGICA, CUIDADO...). Vazio = não prescreve.
  prescricoesAutorizadas        String[]                @default([])
  avatar                        String?
  ativo                         Boolean                 @default(true)
  sessionVersion                Int                     @default(0)
  /// Verificação em duas etapas (TOTP). Segredo cifrado com AES-256-GCM (chave derivada de AUTH_SECRET).
  mfaSegredo                    String?
  mfaAtivo                      Boolean                 @default(false)
  /// Último passo de 30 s aceito: impede reutilizar o mesmo código.
  mfaUltimoPasso                Int?
  /// Hashes SHA-256 dos códigos de recuperação ainda não usados.
  mfaCodigosBackup              String[]                @default([])
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  pontoRegistros                PontoRegistro[]
  feedbacks                     Feedback[]
  triagens                      Triagem[]
  evolucoes                     Evolucao[]
  prescricaos                   Prescricao[]
  receitas                      Receita[]
  agendamentos                  Agendamento[]
  cirurgias                     Cirurgia[]
  movimentacaoEstoques          MovimentacaoEstoque[]
  ticketsCriados                Ticket[]                @relation("TicketCriador")
  mensagensEnviadas             MensagemChat[]          @relation("MensagemEnviada")
  mensagensRecebidas            MensagemChat[]          @relation("MensagemRecebida")
  leiturasCanal                 LeituraCanal[]
  lembretesCriados              Lembrete[]              @relation("LembreteCriador")
  manifestacoesOuvidoria        OuvidoriaTicket[]       @relation("OuvidoriaAutor")
  registrosSinalVital           SinalVital[]
  registrosEscoreClinico        EscoreClinico[]
  registrosAvaliacaoNutricional AvaliacaoNutricional[]
  registrosAvaliacaoMedica      AvaliacaoMedica[]
  registrosAnotacaoEnfermagem   AnotacaoEnfermagem[]
  registrosTimelineEvent        TimelineEvent[]
  examesSolicitados             Exame[]                 @relation("ExameSolicitante")
  examesLiberados               Exame[]                 @relation("ExameLiberador")
  obitosRegistrados             Obito[]
  tokensRedefinicaoSenha        TokenRedefinicaoSenha[]

  @@index([hospitalId])
}

/// "Esqueci minha senha": token de uso único, guardado só como hash SHA-256.
model TokenRedefinicaoSenha {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
}

model Paciente {
  id              String    @id @default(uuid())
  hospitalId      String
  hospital        Hospital  @relation(fields: [hospitalId], references: [id])
  nome            String
  cpf             String?
  /// Cartão Nacional de Saúde (15 dígitos, validado). Identifica o paciente na RNDS quando não há CPF.
  cns             String?
  rg              String?
  nascimento      DateTime?
  sexo            String?
  telefone        String?
  email           String?
  endereco        String?
  convenio        String?
  numConvenio     String?
  mae             String?
  pai             String?
  profissao       String?
  estadoCivil     String?
  nacionalidade   String?
  naturalidade    String?
  religiao        String?
  etnia           String?
  tipoSanguineo   String?
  alergias        String?
  status          String    @default("Recepção")
  classificacao   String?
  leitoTipo       String?
  leitoNumero     Int?
  consultorio     String?
  queixaPrincipal String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  arquivadoEm     DateTime?

  triagens     Triagem[]
  evolucoes    Evolucao[]
  prescricoes  Prescricao[]
  receitas     Receita[]
  agendamentos Agendamento[]
  exames       Exame[]
  cirurgias    Cirurgia[]
  chamadas     Chamada[]

  sinaisVitais         SinalVital[]
  escoresClinicos      EscoreClinico[]
  avaliacoesNutri      AvaliacaoNutricional[]
  visitantes           Visitante[]
  avaliacoesMedicas    AvaliacaoMedica[]
  anotacoesEnf         AnotacaoEnfermagem[]
  timelineEvents       TimelineEvent[]
  movimentacoesEstoque MovimentacaoEstoque[]
  utiLeitos            UtiLeito[]
  salas                Sala[]
  obitos               Obito[]
  internacoes          Internacao[]
  contasFaturamento    ContaFaturamento[]
  vacinasAplicadas     VacinaAplicada[]

  @@unique([cpf, hospitalId]) // Proteção contra CPFs duplicados no mesmo hospital
  @@index([hospitalId, arquivadoEm, createdAt])
  @@index([hospitalId, status])
  @@index([cpf])
}

model Triagem {
  id            String   @id @default(uuid())
  pacienteId    String
  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  classificacao String
  fluxograma    String?
  avpu          String?
  pressao       String? // Mantido como String para formatos como "120/80"
  temperatura   Float? // Convertido para número decimal (ex: 37.5)
  frequenciaC   Int? // Convertido para número inteiro (ex: 80 bpm)
  frequenciaR   Int? // Convertido para número inteiro (ex: 16 irpm)
  saturacao     Int? // Convertido para número inteiro (ex: 98%)
  glicemia      Int? // Convertido para número inteiro (ex: 95 mg/dL)
  peso          Float? // Convertido para número decimal (ex: 75.5 kg)
  altura        Float? // Convertido para número decimal (ex: 1.75 m)
  dor           Int? // Mantido Int (escala de 0 a 10)
  queixa        String?
  observacoes   String?
  profissional  String?
  usuarioId     String?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt     DateTime @default(now())

  @@index([pacienteId])
  @@index([usuarioId])
}

model Evolucao {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  tipo         String
  descricao    String
  profissional String?
  usuarioId    String?
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt    DateTime @default(now())

  @@index([pacienteId])
  @@index([usuarioId])
}

model Prescricao {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  medicamento  String
  dose         String?
  via          String?
  frequencia   String?
  observacoes  String?
  profissional String?
  usuarioId    String?
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt    DateTime @default(now())

  @@index([pacienteId])
  @@index([usuarioId])
}

model Receita {
  id                        String   @id @default(uuid())
  pacienteId                String
  paciente                  Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId                String
  hospital                  Hospital @relation(fields: [hospitalId], references: [id])
  medicamentos              Json
  /// Tipo da prescrição: FARMACOLOGICA, CUIDADO, OXIGENOTERAPIA, DIETA, FISIOTERAPIA, ODONTOLOGICA.
  tipo                      String   @default("FARMACOLOGICA")
  observacoes               String?
  profissional              String?
  /// Foto do registro do prescritor no momento da receita (ex.: "CRM-CE 12345"): a reimpressão não muda se o cadastro mudar.
  registroProfissional      String?
  especialidadeProfissional String?
  usuarioId                 String?
  usuario                   Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt                 DateTime @default(now())

  @@index([pacienteId])
  @@index([hospitalId])
  @@index([usuarioId])
}

model Agendamento {
  id            String            @id @default(uuid())
  pacienteId    String
  paciente      Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId    String
  hospital      Hospital          @relation(fields: [hospitalId], references: [id])
  dataHora      DateTime // Unificado: substitui data e hora soltas
  tipo          String?
  especialidade String?
  profissional  String?
  sala          String?
  status        StatusAgendamento @default(AGENDADO)
  observacoes   String?
  usuarioId     String?
  usuario       Usuario?          @relation(fields: [usuarioId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([pacienteId])
  @@index([hospitalId])
  @@index([dataHora])
  @@index([usuarioId])
}

model Exame {
  usuarioId     String?
  solicitante   Usuario?    @relation("ExameSolicitante", fields: [usuarioId], references: [id], onDelete: SetNull)
  liberadoPorId String?
  liberadoPor   Usuario?    @relation("ExameLiberador", fields: [liberadoPorId], references: [id], onDelete: SetNull)
  liberadoEm    DateTime?
  prioridade    String?
  indicacao     String?
  id            String      @id @default(uuid())
  pacienteId    String
  paciente      Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId    String
  hospital      Hospital    @relation(fields: [hospitalId], references: [id])
  tipo          String
  nome          String
  resultado     String?
  status        StatusExame @default(SOLICITADO)
  profissional  String?
  observacoes   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([pacienteId])
  @@index([hospitalId])
}

model Cirurgia {
  id           String         @id @default(uuid())
  pacienteId   String
  paciente     Paciente       @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  procedimento String
  sala         String?
  dataHora     DateTime? // Unificado: substitui data e hora soltas
  equipe       String?
  anestesia    String?
  status       StatusCirurgia @default(AGENDADA)
  observacoes  String?
  usuarioId    String?
  usuario      Usuario?       @relation(fields: [usuarioId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  checklistEtapas ChecklistCirurgicoEtapa[]

  @@index([pacienteId])
  @@index([hospitalId])
  @@index([usuarioId])
}

model UtiLeito {
  id           String         @id @default(uuid())
  hospitalId   String
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  numero       Int
  tipo         TipoLeito      @default(ADULTO)
  status       StatusOcupacao @default(LIVRE)
  pacienteId   String?
  paciente     Paciente?      @relation(fields: [pacienteId], references: [id])
  pacienteNome String?
  pacienteCpf  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  internacoes        Internacao[]
  movimentacoesLeito MovimentacaoLeito[]

  @@index([hospitalId])
  @@index([pacienteId])
}

// Internação do paciente (item 9). Paciente.status acompanha a internação ativa:
// "Internado - UTI" quando o setor é UTI, "Internado" nos demais; a saída grava o status de desfecho.
// Índice único parcial na migração: no máximo uma internação aberta (saidaEm nulo) por paciente.
model Internacao {
  id                    String               @id @default(uuid())
  hospitalId            String
  hospital              Hospital             @relation(fields: [hospitalId], references: [id])
  pacienteId            String
  paciente              Paciente             @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  entradaEm             DateTime             @default(now())
  setor                 String
  leito                 String?
  utiLeitoId            String?
  utiLeito              UtiLeito?            @relation(fields: [utiLeitoId], references: [id], onDelete: SetNull)
  motivo                String?
  cid                   String?
  medicoResponsavelId   String?
  medicoResponsavelNome String?
  registradoPorId       String?
  registradoPorNome     String?
  saidaEm               DateTime?
  tipoSaida             TipoSaidaInternacao?
  destinoTransferencia  String?
  motivoSaida           String?
  encerradoPorId        String?
  encerradoPorNome      String?
  origem                String               @default("SISTEMA")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  movimentacoes     MovimentacaoLeito[]
  contasFaturamento ContaFaturamento[]
  evolucoesUti      EvolucaoUti[]

  @@index([hospitalId, saidaEm])
  @@index([hospitalId, tipoSaida, saidaEm])
  @@index([pacienteId, entradaEm])
  @@index([utiLeitoId])
}

// Histórico de leitos de uma internação: a linha aberta (fimEm nulo) é o leito atual.
model MovimentacaoLeito {
  id           String     @id @default(uuid())
  hospitalId   String
  hospital     Hospital   @relation(fields: [hospitalId], references: [id])
  internacaoId String
  internacao   Internacao @relation(fields: [internacaoId], references: [id], onDelete: Cascade)
  setor        String
  leito        String?
  utiLeitoId   String?
  utiLeito     UtiLeito?  @relation(fields: [utiLeitoId], references: [id], onDelete: SetNull)
  inicioEm     DateTime   @default(now())
  fimEm        DateTime?
  motivo       String?
  usuarioId    String?
  usuarioNome  String?
  createdAt    DateTime   @default(now())

  @@index([internacaoId, inicioEm])
  @@index([hospitalId])
}

model Sala {
  id           String         @id @default(uuid())
  hospitalId   String
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  nome         String
  tipo         String?
  setor        String?
  andar        String?
  capacidade   Int            @default(1)
  equipamentos String?
  obs          String?
  status       StatusOcupacao @default(LIVRE)
  pacienteId   String?
  paciente     Paciente?      @relation(fields: [pacienteId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  reservas ReservaSala[]

  @@index([hospitalId])
  @@index([pacienteId])
}

model Ticket {
  id          String           @id @default(uuid())
  hospitalId  String
  hospital    Hospital         @relation(fields: [hospitalId], references: [id])
  creatorId   String?
  creator     Usuario?         @relation("TicketCriador", fields: [creatorId], references: [id], onDelete: SetNull)
  numero      Int              @unique @default(autoincrement())
  solicitante String
  titulo      String
  descricao   String
  prioridade  PrioridadeTicket @default(MEDIA)
  status      StatusTicket     @default(ENVIADO)
  respostas   Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([hospitalId])
  @@index([creatorId])
}

model Chamada {
  id           String        @id @default(uuid())
  hospitalId   String
  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  pacienteId   String?
  paciente     Paciente?     @relation(fields: [pacienteId], references: [id])
  pacienteNome String
  cpf          String?
  consultorio  String
  status       StatusChamada @default(ATIVA)
  createdAt    DateTime      @default(now())

  @@index([hospitalId])
}

model Emergencia {
  id               String    @id @default(uuid())
  hospitalId       String
  hospital         Hospital  @relation(fields: [hospitalId], references: [id])
  tipo             String // PANICO | PCR
  profissional     String
  local            String?
  status           String    @default("ATIVA") // ATIVA | ENCERRADA
  usuarioId        String?
  encerradaEm      DateTime?
  encerradaPorId   String?
  encerradaPorNome String?
  createdAt        DateTime  @default(now())

  @@index([hospitalId])
  @@index([hospitalId, status, createdAt])
}

model EstoqueItem {
  id           String    @id @default(uuid())
  hospitalId   String
  hospital     Hospital  @relation(fields: [hospitalId], references: [id])
  categoria    String
  subcategoria String?
  nome         String
  codigo       String?
  quantidade   Int       @default(0)
  unidade      String?
  minimo       Int       @default(0)
  lote         String?
  validade     DateTime?
  fornecedor   String?
  localizacao  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  movimentacoes MovimentacaoEstoque[]

  @@index([hospitalId])
  @@index([categoria])
}

model ModeloProntuario {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  titulo     String
  descricao  String?
  campos     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([hospitalId])
}

model ConfigDashboard {
  id         String   @id @default(uuid())
  hospitalId String   @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  config     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// MÓDULOS DE GESTÃO (Fase 10)
// ==========================================

model Obito {
  pacienteId      String?
  paciente        Paciente? @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  usuarioId       String?
  usuario         Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  id              String    @id @default(uuid())
  hospitalId      String
  hospital        Hospital  @relation(fields: [hospitalId], references: [id])
  nome            String
  nascimento      String?
  cpf             String?
  sexo            String?
  data            String
  hora            String
  local           String?
  causa           String
  causaSec        String?
  medico          String
  prontuario      String?
  responsavel     String?
  telefone        String?
  observacoes     String?
  registradoPor   String?
  dataRegistro    String?
  certidaoEmitida Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([hospitalId])
}

model MensagemChat {
  id          String     @id @default(uuid())
  hospitalId  String
  hospital    Hospital   @relation(fields: [hospitalId], references: [id])
  senderId    String?
  sender      Usuario?   @relation("MensagemEnviada", fields: [senderId], references: [id])
  recipientId String?
  recipient   Usuario?   @relation("MensagemRecebida", fields: [recipientId], references: [id])
  remetente   String
  texto       String
  dataHora    DateTime   @default(now())
  /// Conversa direta: quando o destinatário leu. Em canal fica nulo (a leitura é por pessoa, em LeituraCanal).
  lidaEm      DateTime?
  canalId     String?
  canal       CanalChat? @relation(fields: [canalId], references: [id])

  @@index([hospitalId, senderId, recipientId, dataHora])
  @@index([recipientId, lidaEm])
  @@index([canalId, dataHora])
}

/// Acervo de referência (protocolos, diretrizes, curvas, calendários vacinais, fichas). Compartilhado por todos os
/// hospitais de propósito: é material público de consulta, sem dado de paciente, por isso não tem hospitalId.
/// O arquivo fica num Vercel Blob privado e só sai pela rota autenticada /api/documentos/[slug].
model Documento {
  id          String   @id @default(uuid())
  /// Nome padrão do arquivo, sem extensão (minúsculas, sem acento, hífens). É o que aparece na URL.
  slug        String   @unique
  /// Nome legível, exibido na tela.
  titulo      String
  categoria   String
  grupo       String?
  instituicao String?
  tags        String[]
  /// Caminho dentro do Blob (ex.: biblioteca/diretriz-hipertensao-2025.pdf).
  arquivo     String
  mime        String
  tamanho     Int
  hash        String
  ordem       Int      @default(0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoria, ordem])
}

/// Catálogo de medicamentos registrados (lista CMED/ANVISA), uma linha por apresentação. Compartilhado por todos os
/// hospitais, sem dado de paciente. Alimenta a busca do receituário e a conferência de alergia por substância.
model Medicamento {
  id                  String   @id @default(uuid())
  /// Código GGREM da CMED: identifica a apresentação.
  codigoGgrem         String   @unique
  /// Substância(s) ativa(s); associações vêm separadas por " + ".
  substancia          String
  produto             String
  apresentacao        String
  laboratorio         String
  registro            String?
  classe              String?
  /// Novo, Genérico, Similar, Biológico, Específico, Fitoterápico...
  tipo                String?
  tarja               String?
  restricaoHospitalar Boolean  @default(false)
  /// Consta na Relação Nacional de Medicamentos Essenciais (preenchido pela importação da RENAME).
  rename              Boolean  @default(false)
  /// Texto minúsculo e sem acento para a busca.
  busca               String
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([busca])
}

/// CID-10 oficial (DATASUS). Uma linha por categoria (3 caracteres) e por subcategoria (4 caracteres).
/// `folha` = pode ser escolhido como diagnóstico (categorias que se desdobram em subcategorias não podem).
/// Compartilhado por todos os hospitais; não tem dado de paciente.
model Cid10 {
  id        String  @id @default(uuid())
  /// Com ponto, como se escreve no prontuário: A00.0 (subcategoria) ou A00 (categoria).
  codigo    String  @unique
  descricao String
  tipo      String
  folha     Boolean
  /// Código sem ponto e descrição sem acento, minúsculos, para a busca.
  busca     String

  @@index([busca])
}

/// Canal por setor (UTI, Pronto-Socorro, Enfermagem, Plantão). Aberto a toda a equipe do hospital.
